[Unit]
Description=Prefer the wired (non-VPN) uplink when its cable has carrier
After=NetworkManager.service
Wants=NetworkManager.service

# Bring the wired profile up only when its cable has carrier and it is not
# already connected. It never touches the VPN/fallback uplink, so it cannot
# drop a Tao-routed terminal; re-upping an already-connected profile is a no-op.
[Service]
Type=oneshot
ExecStart=/bin/bash -c '[ "$(cat /sys/class/net/enp0s31f6/carrier 2>/dev/null)" = 1 ] && ! nmcli -t -f DEVICE,STATE device status | grep -qx "enp0s31f6:connected" && nmcli connection up Wired-Primary || true'
TimeoutStartSec=40
